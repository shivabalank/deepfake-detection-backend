# Copy this file to ".env" on the Oracle VM and fill in real values.
# ".env" itself must never be committed to git (already covered by .gitignore
# and .dockerignore).

# Required: direct-download (resolve) link to the trained model checkpoint
# on Hugging Face. Do NOT use a /blob/ URL — that serves an HTML preview
# page, not the raw file, and will break the download.
MODEL_URL=https://huggingface.co/ShivaBalan-k/deepfake-detector-b4/resolve/main/best_model.pth

# Port the Flask/gunicorn server listens on inside the container.
# docker-compose.yml maps this to the same port on the host VM.
PORT=8080

# Optional: restrict CORS to just your Vercel frontend's exact origin
# instead of the current default (any origin, "*"). Leave unset to keep
# existing behavior unchanged. Example:
# ALLOWED_ORIGINS=https://deepfake-detection-eb4.vercel.app
